# ==============================================================================
# Comprehensive GitIgnore for hutta.in Infrastructure & Platform Stack
# ==============================================================================

# macOS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Secrets, Credentials & Keys (CRITICAL - NEVER COMMIT)
**/service-account-key.json
*service-account*.json
*credentials*.json
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.*
!.env.example

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# Ansible & K3s Local State
ansible/inventory.local.ini
*.vault
kubeconfig
*.kubeconfig

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
.pytest_cache/

# Java / Maven
**/target/
*.class
*.jar
*.war
*.log
smdp_server.log

# Node.js / Frontend
node_modules/
dist/
build/

# IDE & Workspace Files
.idea/
.vscode/
website.code-workspace
